{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "outDir": ".server-build",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowJs": true,
    "strict": false,
    "declaration": false,
    "noEmit": false
  },
  "include": [
    "server.ts",
    "server-fallback.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "src",
    "netlify"
  ]
}
