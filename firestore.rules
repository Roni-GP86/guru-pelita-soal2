rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }
    
    // Helper functions
    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }
    
    function incoming() { 
      return request.resource.data; 
    }
    
    function existing() { 
      return resource.data; 
    }

    function isValidCodeRequest(data) {
      return data.keys().hasAll(['id', 'schoolName', 'teacherName', 'uniqueCode', 'isActive'])
        && data.keys().size() <= 11
        && data.id is string && data.id.size() <= 100
        && data.schoolName is string && data.schoolName.size() <= 200
        && data.teacherName is string && data.teacherName.size() <= 200
        && data.uniqueCode is string && data.uniqueCode.size() <= 50
        && data.isActive is bool
        && (!('role' in data) || (data.role is string && data.role.size() <= 100))
        && (!('subject' in data) || (data.subject is string && data.subject.size() <= 100))
        && (!('whatsappNumber' in data) || (data.whatsappNumber is string && data.whatsappNumber.size() <= 50))
        && (!('buktiTransfer' in data) || (data.buktiTransfer is string && data.buktiTransfer.size() <= 8200000))
        && (!('timestamp' in data) || (data.timestamp is string && data.timestamp.size() <= 100));
    }

    // Collection match
    match /codeRequests/{requestId} {
      allow get: if isValidId(requestId);
      allow list: if true;
      allow create: if isValidId(requestId) && isValidCodeRequest(incoming());
      allow update: if isValidId(requestId) && isValidCodeRequest(incoming()) && (
        incoming().id == existing().id &&
        incoming().uniqueCode == existing().uniqueCode
      );
      allow delete: if true; // Allow admin deletion or resets
    }

    match /systemSettings/{settingId} {
      allow read, write: if isValidId(settingId);
    }
  }
}
